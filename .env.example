# PostgreSQL Database URL for Prisma
# Jika menggunakan docker-compose bawaan, gunakan password 'postgrespassword':
# DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/voicash?schema=public"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/voicash?schema=public"

# Secret key for stateless JWT sessions (minimal 32 karakter)
JWT_SECRET="super-secret-voicash-jwt-key-minimum-32-chars"

# App Environment
NODE_ENV="development"

# LLM Configuration (Opsional: untuk AI Copilot & OCR Struk via Cloud LLM)
# Jika dikosongkan, VoiCash otomatis fallback ke NLP & Copilot lokal bawaan
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

