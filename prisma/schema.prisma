generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  password     String
  name         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  profile      Profile?
  transactions Transaction[]
  wishlists    Wishlist[]
  expenses     Expense[]
  documents    UserDocument[]

  @@map("users")
}

model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname  String   @default("Teman")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

model Transaction {
  id              String   @id // Client-generated UUID v4
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String   // "income" | "expense"
  itemName        String
  amount          Int
  category        String
  source          String   @default("manual") // "manual" | "voice" | "ocr"
  transactionDate DateTime @default(now())
  isDeleted       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  serverUpdatedAt DateTime @default(now()) @updatedAt

  @@index([userId, transactionDate])
  @@index([userId, type])
  @@index([userId, serverUpdatedAt])
  @@map("transactions")
}

model Wishlist {
  id              String   @id // Client-generated UUID v4
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  targetPrice     Int
  savedAmount     Int      @default(0)
  priority        Int      @default(1)
  isAchieved      Boolean  @default(false)
  isDeleted       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  serverUpdatedAt DateTime @default(now()) @updatedAt

  @@index([userId, isAchieved])
  @@index([userId, serverUpdatedAt])
  @@map("wishlists")
}

model Expense {
  id              String   @id
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemName        String
  amount          Int
  walletId        String?
  category        String
  isDeleted       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  serverUpdatedAt DateTime @default(now()) @updatedAt

  @@index([userId, serverUpdatedAt])
  @@map("expenses")
}

model UserDocument {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key             String
  data            Json
  isDeleted       Boolean  @default(false)
  clientUpdatedAt DateTime
  serverUpdatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, key])
  @@index([userId, serverUpdatedAt])
  @@map("user_documents")
}
